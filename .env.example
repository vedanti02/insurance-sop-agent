# Required for live mode. Any OpenAI-compatible key.
LLM_API_KEY=sk-...
LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.openai.com/v1
PERCEIVE_MODEL=gpt-4.1-mini
RESPOND_MODEL=gpt-4.1

# "live" or "stub" (stub needs no key; used by tests)
LLM_MODE=live

# The SOP's notion of today. Fixture appeal deadlines fall in Mar/Apr 2026.
DEMO_TODAY=2026-03-01
# Which consent_scenarios.json entry the representative flow uses: default | timeout
CONSENT_SCENARIO=default
MAX_MODEL_CALLS_PER_TURN=3
